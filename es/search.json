---
layout: none
---

{% assign posts = site.es | sort: 'date' | reverse %}
[
  {% for post in posts %}
    {
      "title"    : "{{ post.title | escape }}",
      "category" : "{{ post.categories | join: ' ' }}",
      "url"      : "{{ post.url }}",
      "date"     : "{{ post.date | date: "%d/%m/%Y" }}"
    } {% unless forloop.last %},{% endunless %}
  {% endfor %}
]
